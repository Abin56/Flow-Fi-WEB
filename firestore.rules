rules_version = '2';

// FlowFi Firestore Security Rules
//
// CANONICAL COPY. This file MUST stay byte-identical between this repo
// (flowfi-web) and Finance_App/firestore.rules. Both apps (the Flutter app
// and this Next.js app) share a single Firebase project (financeapp-585eb)
// and therefore a single deployed rules set — Firestore rules are
// project-wide, not per-app. The two copies had drifted (this file had
// gained a `pdfAnalyzerConfig` rule the Flutter copy lacked) until the
// 2026-09-23 Mobile↔Web parity audit reconciled them; only ever deploy this
// file (or the Finance_App copy, which must be kept equal to it) from a
// single point of truth going forward.
//
// IMPORTANT — Firestore rule-matching semantics (learned the hard way, see
// tests/rules/firestore.rules.test.ts and the emulator run that caught it):
// Firestore does NOT pick "the most specific matching rule." If multiple
// `match` blocks match a given path, access is granted if ANY of them
// allows it (OR, not override). A single blanket `users/{uid}/{document=**}`
// rule therefore CANNOT be safely combined with stricter per-collection
// overrides — every user-scoped collection is listed explicitly below
// instead.
//
// Backlog task: M1-T1.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The user's own profile document (displayName/email/photoURL/
    // lastLoginAt/createdAt) — written by the Flutter app's
    // UserProfileRepository.upsertOnSignIn on every sign-in. Distinct from
    // the subcollections below, which live under this same path but were
    // previously the only rules present here.
    match /users/{uid} { allow read, write: if isOwner(uid); }

    // --- Pre-existing app collections (lib/firestore/collections.ts /
    // lib/core/constants/firestore_constants.dart) ---
    // Simple owner-scoped CRUD, matching how this app has always worked —
    // there is no Cloud Functions layer in front of these today, so
    // tightening them further here would be an unrelated, uncoordinated
    // behavior change outside this backlog's scope. Each match's
    // {document=**} also covers that collection's own nested subcollections
    // (ledger under people, occurrences/payments under bills, installments
    // under paymentSchedules, paymentBreakdowns under emis, statements/
    // statementPayments under creditCards).
    match /users/{uid}/accounts/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/transactions/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/categories/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/budgets/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/savingsGoals/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/people/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/bills/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/loans/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/emis/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/expenses/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/paymentSchedules/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/creditCards/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/sharedCreditLimits/{document=**} { allow read, write: if isOwner(uid); }

    // pdfAnalyzerConfig: one doc per card (fixed id == cardId), holding only
    // a password-generation RULE — never raw personal data (DOB/PAN/etc.),
    // so client write access here carries none of the risk the Financial
    // Document Intelligence collections below are restricted against.
    // Web-only feature today (no Flutter-side repository layer exists yet),
    // but the rule must be present here too since rules are project-wide.
    match /users/{uid}/pdfAnalyzerConfig/{document=**} { allow read, write: if isOwner(uid); }

    // --- Financial Document Intelligence Engine (Architecture v1.0) ---
    // Reconciled onto users/{uid}/... by docs/adr/ADR-002. More restrictive
    // than the collections above, because these back the parsing pipeline's
    // integrity guarantees (Architecture §5/§29: "parsing remains
    // server-side only") rather than being plain user-entered CRUD data.
    // Web-only feature today (no Flutter-side repository layer exists yet
    // for these collections — see docs/firebase-backend-audit.md), but the
    // rules must be present here too since rules are project-wide.

    // financialDocuments: created and status-transitioned only by the
    // ingestion/parsing Cloud Functions (backlog M2-T1, M2-T2), via the
    // Admin SDK, which is not subject to these rules at all. Clients may
    // only read their own documents — never write, so a client can't
    // fabricate parse results or short-circuit the pipeline.
    match /users/{uid}/financialDocuments/{documentId} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /importHistory/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /versionHistory/{versionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /changeLog/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // documentImports: the staging area the Review Workspace (backlog
    // Milestone 8) reads and edits directly — unlike financialDocuments,
    // this is meant to be client-writable, since split/merge/recategorize/
    // tag/delete are exactly what Review does. Two restrictions matter:
    //   1. A client can never CREATE a documentImports doc — only the
    //      parsing worker may, so a client can't inject fabricated staged
    //      data that was never actually parsed from a real document.
    //   2. A client can never set status to "committed" — only the Import
    //      Engine (backlog Milestone 9) may, preserving the atomicity/
    //      idempotency guarantees RFC §28.9 requires.
    match /users/{uid}/documentImports/{importId} {
      allow read: if isOwner(uid);
      allow create: if false;
      allow update: if isOwner(uid) && request.resource.data.status in ['draft', 'reviewing', 'discarded'];
      allow delete: if isOwner(uid) && resource.data.status in ['draft', 'reviewing'];

      match /records/{recordId} {
        allow read, write: if isOwner(uid);
      }
    }

    // SMS Transaction Intelligence (Phase 3) — structured candidates built
    // entirely on-device by Android from the user's own SMS; the raw message
    // never leaves the device. Plain owner-scoped CRUD like accounts/
    // transactions above: unlike documentImports, there is no separate
    // server-side worker — the Android app itself both creates and deletes
    // these documents (`SmsCandidateCloudSync`), and the web app only reads
    // and deletes (see lib/repositories/sms-transaction-candidate-repository.ts).
    // There is no status/state-machine field on this document at all — an
    // earlier version of this rule invented one; that was never real,
    // corrected once the actual Android-side model was found and audited.
    //
    // smsCandidateTombstones proposal (2026-10-23, docs/sms-candidate-contract.md
    // + Finance_App/docs/sms-background-cloud-sync-architecture.md): a durable
    // "handled" marker, same id as the candidate it replaces. `create` on the
    // candidate is denied once a tombstone with that id exists — the one
    // server-side backstop against a resurrected candidate, independent of
    // any client-side (Android transaction / web batch) logic. This only
    // guards `create` (the doc not previously existing): Web's delete +
    // tombstone write is a single atomic WriteBatch, so no reader — including
    // this rule evaluation — can ever observe "tombstone exists but candidate
    // doc still exists" as an intermediate state from that batch. It does
    // NOT by itself make the Android-side upload race-safe; that still
    // requires Android's own `runTransaction` (reads the tombstone inside the
    // same transaction that writes the candidate) — see the architecture doc,
    // §2/§5.
    //
    // SMS Sync pairing (2026-10-25): both writes (Android's `tx.set` is a
    // create or an update) are also refused while an operator switch is set
    // — the global emergency kill switch (`smsSyncControl/global`) or this
    // account's hold (`smsSyncConfig/operatorHold`). Android's F3 gate checks
    // the same documents first; this is the backstop that holds even for a
    // modified client. Web never writes candidates, so its read/delete
    // (import/dismiss) keeps working during an incident.
    function smsUploadsSuspended(uid) {
      let globalControl = /databases/$(database)/documents/smsSyncControl/global;
      let hold = /databases/$(database)/documents/users/$(uid)/smsSyncConfig/operatorHold;
      return (exists(globalControl) && get(globalControl).data.get('uploadsDisabled', false) == true) ||
        (exists(hold) && get(hold).data.get('disabled', false) == true);
    }

    // Server-side pairing backstop (SMS Sync lifecycle, 2026-10-25): only the pairing Cloud Functions (or an
    // operator) can switch `backgroundUpload` on, and Auto Sync OFF / Disconnect revokes it. Requiring it here means
    // a queued or retrying upload from a phone that is no longer paired is refused even if its own gate was passed
    // before the revocation landed. The Web never creates or updates candidates (it only deletes), so it is
    // unaffected.
    function smsUploadAuthorized(uid) {
      let path = /databases/$(database)/documents/users/$(uid)/smsSyncConfig/backgroundUpload;
      return exists(path) && get(path).data.get('enabled', false) == true;
    }

    match /users/{uid}/smsTransactionCandidates/{candidateId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) &&
        !exists(/databases/$(database)/documents/users/$(uid)/smsCandidateTombstones/$(candidateId)) &&
        !smsUploadsSuspended(uid) && smsUploadAuthorized(uid);
      allow update: if isOwner(uid) && !smsUploadsSuspended(uid) && smsUploadAuthorized(uid);
    }

    // Handled-state record for an imported or dismissed SMS candidate — see
    // the `smsTransactionCandidates` comment above. Fully immutable once
    // written: a dismissed candidate can never later be silently rewritten
    // as imported or vice versa, and nothing can delete the record either.
    // Same id as the candidate document it replaces.
    //
    // `delete` is deliberately NOT granted (Phase B security review,
    // 2026-10-24): no approved workflow — Web's import/dismiss, nor any
    // planned Android read — ever deletes a tombstone, and the approved
    // retention policy is "keep indefinitely, no automatic TTL" (see the
    // architecture doc, §1). Owner-write delete access here would be a
    // standing capability with no legitimate caller, and a real risk if a
    // compromised/buggy client ever used it: deleting a tombstone re-opens
    // exactly the resurrection window the `!exists()` guard on
    // `smsTransactionCandidates.create` exists to close. A future admin-side
    // retention/TTL job (if the "revisit later" decision above ever adds
    // one) would run via the Admin SDK, which isn't subject to these rules
    // at all — so it needs no client delete permission either.
    match /users/{uid}/smsCandidateTombstones/{candidateId} {
      allow read, create: if isOwner(uid);
      allow update, delete: if false;
    }

    // Runtime switch for Android's background SMS cloud upload (Phase F3,
    // 2026-10-25) — one document, `backgroundUpload`, naming the single
    // account-device pair allowed to upload (`enabled: true`, `deviceId`). The
    // app only READS it (server read, fail-closed). Clients can NEVER write it,
    // so a compromised or buggy client cannot switch uploads on for itself:
    // it is created/edited/deleted only by an operator via the Firebase console
    // or Admin SDK (neither is subject to these rules). Because it lives under
    // users/{uid}, one account's document can never authorize another's.
    //
    // Since SMS Sync pairing (2026-10-25) the pairing Cloud Functions
    // (functions/src/sms-pairing) also write `backgroundUpload`, via the Admin
    // SDK, only after a signed-in user approved a single-use QR session on the
    // phone. Clients still never write here. `operatorHold` (per-account
    // operator stop) lives in this collection too and pairing never writes it.
    match /users/{uid}/smsSyncConfig/{configId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Paired SMS Sync devices — written only by the pairing Cloud Functions
    // (register on approval, `replaced` when another phone is paired,
    // `revoked` on user disconnect). Clients read their own, never write.
    match /users/{uid}/smsDevices/{deviceId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Self-reported health from a paired phone (permission, Auto Sync, last
    // scan/upload) — what the web setup progress shows. Only the owner, only
    // for a device that is currently `active` in smsDevices, only this exact
    // schema, and `reportedAt` must be the server's own time, so a "last
    // reported" timestamp can't be forged or backdated. It is still the
    // phone's own report, and the web words it that way.
    function isActiveSmsDevice(uid, deviceId) {
      let path = /databases/$(database)/documents/users/$(uid)/smsDevices/$(deviceId);
      return exists(path) && get(path).data.status == 'active';
    }

    function isValidSmsDeviceStatus(deviceId) {
      let d = request.resource.data;
      let fields = ['deviceId', 'smsPermission', 'autoSyncEnabled', 'cloudSync', 'lastScanAt', 'lastScanOutcome',
        'lastUploadAt', 'lastUploadOutcome', 'lastUploadedCount', 'pendingNotOwnedCount', 'appVersion', 'reportedAt'];
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields) &&
        d.deviceId == deviceId &&
        d.reportedAt == request.time &&
        d.smsPermission in ['granted', 'denied', 'permanentlyDenied', 'unsupported', 'unknown'] &&
        d.autoSyncEnabled is bool &&
        (d.cloudSync == null || d.cloudSync in ['enabled', 'disabled', 'unverified']) &&
        (d.lastScanAt == null || d.lastScanAt is timestamp) &&
        (d.lastScanOutcome == null || d.lastScanOutcome in ['ok', 'permission', 'failed']) &&
        (d.lastUploadAt == null || d.lastUploadAt is timestamp) &&
        (d.lastUploadOutcome == null || d.lastUploadOutcome in ['ok', 'failed']) &&
        d.lastUploadedCount is int && d.lastUploadedCount >= 0 && d.lastUploadedCount <= 100000 &&
        d.pendingNotOwnedCount is int && d.pendingNotOwnedCount >= 0 && d.pendingNotOwnedCount <= 100000 &&
        (d.appVersion == null || (d.appVersion is string && d.appVersion.size() <= 32));
    }

    match /users/{uid}/smsDeviceStatus/{deviceId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isActiveSmsDevice(uid, deviceId) && isValidSmsDeviceStatus(deviceId);
      allow delete: if false;
    }

    // Live presence for FlowFi Web (SMS Sync lifecycle, 2026-10-25): any signed-in install of the owner may report
    // its own heartbeat BEFORE pairing, so the web can show online / permission / Auto Sync / sync progress live.
    // It grants nothing — pairing and upload authority stay in smsDevices + backgroundUpload, server-written only.
    // Exact schema, enums and bounded counters only: no SMS text, sender, OTP, account or card details.
    // `heartbeatAt` is the server's time, so a stale document can always be recognized as stale.
    function isValidSmsDevicePresence(deviceId) {
      let d = request.resource.data;
      let fields = ['deviceId', 'label', 'platform', 'appVersion', 'appState', 'smsPermission', 'notificationAccess',
        'autoSyncEnabled', 'syncPhase', 'syncTotal', 'syncDone', 'syncUploaded', 'syncSkipped', 'syncFailed',
        'syncUpdatedAt', 'lastSyncAt', 'heartbeatAt'];
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields) &&
        d.deviceId == deviceId && deviceId.size() <= 64 &&
        d.heartbeatAt == request.time &&
        (d.label == null || (d.label is string && d.label.size() <= 60)) &&
        d.platform == 'android' &&
        (d.appVersion == null || (d.appVersion is string && d.appVersion.size() <= 32)) &&
        d.appState in ['foreground', 'background'] &&
        d.smsPermission in ['granted', 'denied', 'permanentlyDenied', 'unsupported', 'unknown'] &&
        d.notificationAccess in ['granted', 'denied', 'unsupported', 'unknown'] &&
        d.autoSyncEnabled is bool &&
        d.syncPhase in ['idle', 'scanning', 'uploading', 'done', 'failed'] &&
        (d.syncTotal == null || (d.syncTotal is int && d.syncTotal >= 0 && d.syncTotal <= 100000)) &&
        d.syncDone is int && d.syncDone >= 0 && d.syncDone <= 100000 &&
        d.syncUploaded is int && d.syncUploaded >= 0 && d.syncUploaded <= 100000 &&
        d.syncSkipped is int && d.syncSkipped >= 0 && d.syncSkipped <= 100000 &&
        d.syncFailed is int && d.syncFailed >= 0 && d.syncFailed <= 100000 &&
        (d.syncUpdatedAt == null || d.syncUpdatedAt is timestamp) &&
        (d.lastSyncAt == null || d.lastSyncAt is timestamp);
    }

    match /users/{uid}/smsDevicePresence/{deviceId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidSmsDevicePresence(deviceId);
      allow delete: if false;
    }

    // Personal merchant mapping corrections (Architecture §11.2, write-side
    // learning loop, backlog M13-T1) — plain owner-scoped CRUD, same as the
    // pre-existing collections above.
    match /users/{uid}/merchantMappings/{mappingId} {
      allow read, write: if isOwner(uid);
    }

    // parserHistory: diagnostics written by the parsing worker (backlog
    // M13-T3) — informative for the user's own audit trail (Architecture
    // §24) but never client-authored, so it stays a trustworthy record of
    // what the pipeline actually did.
    match /users/{uid}/parserHistory/{entryId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // aiInsights: generated by the Insight Engine (backlog Milestone 12).
    // The one thing a client may legitimately change is dismissing an
    // insight — everything else (the message, the numbers behind it) must
    // stay exactly what the rule-triggered engine computed.
    match /users/{uid}/aiInsights/{insightId} {
      allow read: if isOwner(uid);
      allow create, delete: if false;
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissed']);
    }

    // --- Global, cross-user config/data — NOT under users/{uid} ---

    // SMS Sync QR pairing sessions — created, opened, approved and canceled
    // only by the pairing Cloud Functions. Top-level because the phone
    // presents only the token (whose SHA-256 is this document's id), not the
    // owner's uid. The owner may read their own session (the web's live
    // progress); no one else can, and no client can write.
    match /smsPairingSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Operator-only emergency switches for SMS Sync (`global`:
    // `uploadsDisabled`). Readable by any signed-in client so Android's gate
    // can fail closed on it; written only via the Admin SDK / console.
    match /smsSyncControl/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Document Type Registry (Architecture §3): defines the parsing
    // pipeline's behavior per document type. Deployed via CI using the
    // Admin SDK (docs/adr/ADR-001) — never editable by any client, staging
    // or production, which is what keeps registry changes reviewable code
    // rather than ad-hoc Firestore edits (RFC §28.13).
    match /documentTypeRegistry/{documentType} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Global merchant alias table (Architecture §11.2, docs/adr/ADR-002).
    // Promotion from a user's personal correction
    // (users/{uid}/merchantMappings) to this global table is corroboration-
    // gated (backlog M13-T2) and happens via the Admin SDK only — this is
    // exactly the control RFC §28.5's global-mapping-poisoning finding
    // required, so clients never get a direct write path here.
    match /merchantMappings/{mappingId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
